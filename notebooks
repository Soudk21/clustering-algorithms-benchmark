      "source": [
        "# ======================================================\n",
        "# 1. Imports and global settings\n",
        "# ======================================================\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import time\n",
        "\n",
        "from sklearn.preprocessing import LabelEncoder\n",
        "from sklearn.decomposition import PCA\n",
        "from sklearn.metrics import precision_score, recall_score, f1_score\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "sns.set(style=\"whitegrid\")  # seaborn style for all plots\n",
        "\n",
        "# ======================================================\n",
        "# 2. Load datasets, standardize features, encode labels\n",
        "# ======================================================\n",
        "\n",
        "dataset_names = [\n",
        "    \"banknote\",\n",
        "    \"ionosphere\",\n",
        "    \"sonar\",\n",
        "    \"blobs\",\n",
        "    \"varied\",\n",
        "    \"wine\",\n",
        "    \"flame\",\n",
        "    \"glass\",\n",
        "    \"iris\"\n",
        "]\n",
        "\n",
        "data = {}\n",
        "\n",
        "for name in dataset_names:\n",
        "    # If your CSVs have headers, change header=None to header=0\n",
        "    df = pd.read_csv(f\"{name}.csv\", header=None)\n",
        "\n",
        "    X = df.iloc[:, :-1].values.astype(float)  # features\n",
        "    y_raw = df.iloc[:, -1].values            # original labels (could be strings)\n",
        "\n",
        "    # Standardization: zero mean, unit variance\n",
        "    mean = X.mean(axis=0)\n",
        "    std = X.std(axis=0)\n",
        "    std[std == 0.0] = 1.0  # avoid division by zero\n",
        "    X_std = (X - mean) / std\n",
        "\n",
        "    # Encode labels into integers 0..C-1 for evaluation / np.bincount\n",
        "    le = LabelEncoder()\n",
        "    y_enc = le.fit_transform(y_raw)\n",
        "\n",
        "    data[name] = {\n",
        "        \"X\": X_std,\n",
        "        \"y\": y_enc,\n",
        "        \"label_encoder\": le\n",
        "    }\n",
        "\n",
        "    print(f\"{name}: X shape = {X_std.shape}, unique encoded labels = {np.unique(y_enc)}\")\n",
        "\n",
        "\n",
        "# ======================================================\n",
        "# 3. DBSCAN (from scratch, no sklearn)\n",
        "# ======================================================\n",
        "def dbscan_from_scratch(X, eps=0.5, min_samples=5):\n",
        "    \"\"\"\n",
        "    Simple DBSCAN implementation from scratch.\n",
        "\n",
        "    Parameters:\n",
        "        X: array of shape (n_samples, n_features)\n",
        "        eps: neighborhood radius\n",
        "        min_samples: minimum number of points to form a dense region\n",
        "\n",
        "    Returns:\n",
        "        labels: array of shape (n_samples,), cluster labels\n",
        "                -1 indicates noise.\n",
        "    \"\"\"\n",
        "    X = np.asarray(X)\n",
        "    n = X.shape[0]\n",
        "\n",
        "    # Precompute pairwise distances (Euclidean)\n",
        "    dists = np.linalg.norm(X[:, None, :] - X[None, :, :], axis=2)\n",
        "\n",
        "    labels = np.full(n, -1, dtype=int)  # -1 means noise/unassigned\n",
        "    visited = np.zeros(n, dtype=bool)\n",
        "\n",
        "    cluster_id = 0\n",
        "\n",
        "    for i in range(n):\n",
        "        if visited[i]:\n",
        "            continue\n",
        "\n",
        "        visited[i] = True\n",
        "        # Neighborhood of point i\n",
        "        neighbors = np.where(dists[i] <= eps)[0]\n",
        "\n",
        "        if neighbors.size < min_samples:\n",
        "            # mark as noise for now; might become border point later\n",
        "            labels[i] = -1\n",
        "        else:\n",
        "            # create new cluster\n",
        "            labels[i] = cluster_id\n",
        "\n",
        "            # seeds: points to be processed/expanded\n",
        "            seeds = list(neighbors)\n",
        "            if i in seeds:\n",
        "                seeds.remove(i)\n",
        "\n",
        "            seeds_mask = np.zeros(n, dtype=bool)\n",
        "            seeds_mask[seeds] = True\n",
        "\n",
        "            while seeds:\n",
        "                current_point = seeds.pop()\n",
        "                seeds_mask[current_point] = False\n",
        "\n",
        "                if not visited[current_point]:\n",
        "                    visited[current_point] = True\n",
        "                    current_neighbors = np.where(dists[current_point] <= eps)[0]\n",
        "\n",
        "                    if current_neighbors.size >= min_samples:\n",
        "                        # add new neighbors to seeds if not already in it\n",
        "                        for nb in current_neighbors:\n",
        "                            if not seeds_mask[nb] and labels[nb] == -1:\n",
        "                                seeds.append(nb)\n",
        "                                seeds_mask[nb] = True\n",
        "\n",
        "                # assign to cluster if it is noise or unassigned\n",
        "                if labels[current_point] == -1:\n",
        "                    labels[current_point] = cluster_id\n",
        "\n",
        "            cluster_id += 1\n",
        "\n",
        "    return labels\n",
        "\n",
        "\n",
        "# ======================================================\n",
        "# 4. Evaluation function (uses encoded integer labels)\n",
        "# ======================================================\n",
        "def evaluate_clustering_with_labels(y_true, cluster_labels):\n",
        "    \"\"\"\n",
        "    Evaluate clustering using known labels.\n",
        "\n",
        "    Noise points (cluster_labels == -1) are excluded from evaluation.\n",
        "\n",
        "    Assumes y_true are encoded integers 0..C-1.\n",
        "\n",
        "    Returns a dict with:\n",
        "        purity, accuracy, precision_macro, recall_macro, f1_macro, n_eval_samples, coverage\n",
        "    coverage = n_eval_samples / total_samples\n",
        "    \"\"\"\n",
        "    y_true = np.asarray(y_true)\n",
        "    cluster_labels = np.asarray(cluster_labels)\n",
        "\n",
        "    # mask to ignore noise\n",
        "    mask = cluster_labels != -1\n",
        "    if mask.sum() == 0:\n",
        "        # no points assigned to any cluster\n",
        "        return {\n",
        "            \"purity\": 0.0,\n",
        "            \"accuracy\": 0.0,\n",
        "            \"precision_macro\": 0.0,\n",
        "            \"recall_macro\": 0.0,\n",
        "            \"f1_macro\": 0.0,\n",
        "            \"n_eval_samples\": 0,\n",
        "            \"coverage\": 0.0\n",
        "        }\n",
        "\n",
        "    y_eval = y_true[mask]\n",
        "    c_eval = cluster_labels[mask]\n",
        "\n",
        "    # Map each cluster to the majority true label within that cluster\n",
        "    y_pred = np.zeros_like(y_eval)\n",
        "\n",
        "    unique_clusters = np.unique(c_eval)\n",
        "    for c in unique_clusters:\n",
        "        idx = (c_eval == c)\n",
        "        true_labels_in_cluster = y_eval[idx]\n",
        "        # majority vote (y_eval are non-negative ints)\n",
        "        majority_label = np.bincount(true_labels_in_cluster).argmax()\n",
        "        y_pred[idx] = majority_label\n",
        "\n",
        "    accuracy = (y_pred == y_eval).mean()\n",
        "    purity = accuracy  # with majority mapping, purity == accuracy\n",
        "\n",
        "    precision_macro = precision_score(y_eval, y_pred, average=\"macro\", zero_division=0)\n",
        "    recall_macro = recall_score(y_eval, y_pred, average=\"macro\", zero_division=0)\n",
        "    f1_macro = f1_score(y_eval, y_pred, average=\"macro\", zero_division=0)\n",
        "\n",
        "    coverage = len(y_eval) / len(y_true)\n",
        "\n",
        "    return {\n",
        "        \"purity\": float(purity),\n",
        "        \"accuracy\": float(accuracy),\n",
        "        \"precision_macro\": float(precision_macro),\n",
        "        \"recall_macro\": float(recall_macro),\n",
        "        \"f1_macro\": float(f1_macro),\n",
        "        \"n_eval_samples\": int(len(y_eval)),\n",
        "        \"coverage\": float(coverage)\n",
        "    }\n",
        "\n",
        "\n",
        "# ======================================================\n",
        "# 5. Automatic tuning: grid search over eps and min_samples\n",
        "# ======================================================\n",
        "def run_dbscan_grid(X_pca, y, eps_values, min_samples_values):\n",
        "    \"\"\"\n",
        "    Runs DBSCAN (from scratch) for all combinations of eps and min_samples.\n",
        "    Returns a DataFrame with metrics per configuration.\n",
        "    \"\"\"\n",
        "    records = []\n",
        "\n",
        "    for eps in eps_values:\n",
        "        for ms in min_samples_values:\n",
        "            start = time.time()\n",
        "            cluster_labels = dbscan_from_scratch(X_pca, eps=eps, min_samples=ms)\n",
        "            runtime = time.time() - start\n",
        "\n",
        "            metrics = evaluate_clustering_with_labels(y, cluster_labels)\n",
        "            rec = {\n",
        "                \"eps\": eps,\n",
        "                \"min_samples\": ms,\n",
        "                \"runtime_sec\": runtime,\n",
        "                \"purity\": metrics[\"purity\"],\n",
        "                \"accuracy\": metrics[\"accuracy\"],\n",
        "                \"precision_macro\": metrics[\"precision_macro\"],\n",
        "                \"recall_macro\": metrics[\"recall_macro\"],\n",
        "                \"f1_macro\": metrics[\"f1_macro\"],\n",
        "                \"n_eval_samples\": metrics[\"n_eval_samples\"],\n",
        "                \"coverage\": metrics[\"coverage\"]\n",
        "            }\n",
        "            records.append(rec)\n",
        "\n",
        "    df = pd.DataFrame(records)\n",
        "    return df\n",
        "\n",
        "\n",
        "def pick_best_config(df, min_coverage=0.5):\n",
        "    \"\"\"\n",
        "    Pick best configuration from grid search:\n",
        "\n",
        "    - Prefer configurations with coverage >= min_coverage (if any exist).\n",
        "    - Among them, maximize f1_macro, then purity, then coverage.\n",
        "    - If no configuration has coverage >= min_coverage, pick from all\n",
        "      non-zero-eval configs using same ranking.\n",
        "    \"\"\"\n",
        "    df_valid = df[df[\"n_eval_samples\"] > 0].copy()\n",
        "    if df_valid.empty:\n",
        "        # No non-noise clustering; just return the row with largest coverage\n",
        "        return df.sort_values(by=[\"coverage\", \"f1_macro\", \"purity\"],\n",
        "                              ascending=False).iloc[0]\n",
        "\n",
        "    df_cov = df_valid[df_valid[\"coverage\"] >= min_coverage]\n",
        "    if not df_cov.empty:\n",
        "        df_to_search = df_cov\n",
        "    else:\n",
        "        df_to_search = df_valid\n",
        "\n",
        "    df_sorted = df_to_search.sort_values(\n",
        "        by=[\"f1_macro\", \"purity\", \"coverage\"],\n",
        "        ascending=False\n",
        "    ).reset_index(drop=True)\n",
        "\n",
        "    return df_sorted.iloc[0]\n",
        "\n",
        "\n",
        "# ======================================================\n",
        "# 6. Main loop: PCA, tuning, best config, plots, summary table\n",
        "# ======================================================\n",
        "\n",
        "# Grid for automatic tuning\n",
        "eps_values = np.linspace(0.2, 2.0, 10)    # from 0.2 to 2.0\n",
        "min_samples_values = [3, 5, 8, 10]\n",
        "\n",
        "best_results = []  # will collect best config per dataset\n",
        "\n",
        "for name in dataset_names:\n",
        "    print(\"\\n\" + \"=\" * 60)\n",
        "    print(f\"Dataset: {name}\")\n",
        "    print(\"=\" * 60)\n",
        "\n",
        "    X = data[name][\"X\"]\n",
        "    y = data[name][\"y\"]\n",
        "    le = data[name][\"label_encoder\"]\n",
        "\n",
        "    # PCA to 2D\n",
        "    pca = PCA(n_components=2)\n",
        "    X_pca = pca.fit_transform(X)\n",
        "    evr = pca.explained_variance_ratio_\n",
        "    print(f\"PCA explained variance ratio (PC1, PC2): {evr}\")\n",
        "\n",
        "    # Grid search for DBSCAN parameters\n",
        "    grid_df = run_dbscan_grid(X_pca, y, eps_values, min_samples_values)\n",
        "\n",
        "    # Select best configuration (automatic tuning)\n",
        "    best = pick_best_config(grid_df, min_coverage=0.5)\n",
        "    best_eps = float(best[\"eps\"])\n",
        "    best_ms = int(best[\"min_samples\"])\n",
        "\n",
        "    print(\"\\nBest configuration (automatic tuning):\")\n",
        "    print(best)\n",
        "\n",
        "    # Re-run DBSCAN with best hyperparameters to get final clustering\n",
        "    best_cluster_labels = dbscan_from_scratch(X_pca, eps=best_eps, min_samples=best_ms)\n",
        "    final_metrics = evaluate_clustering_with_labels(y, best_cluster_labels)\n",
        "\n",
        "    # Store summary for this dataset\n",
        "    result_row = {\n",
        "        \"dataset\": name,\n",
        "        \"eps\": best_eps,\n",
        "        \"min_samples\": best_ms,\n",
        "        \"purity\": final_metrics[\"purity\"],\n",
        "        \"accuracy\": final_metrics[\"accuracy\"],\n",
        "        \"precision_macro\": final_metrics[\"precision_macro\"],\n",
        "        \"recall_macro\": final_metrics[\"recall_macro\"],\n",
        "        \"f1_macro\": final_metrics[\"f1_macro\"],\n",
        "        \"n_eval_samples\": final_metrics[\"n_eval_samples\"],\n",
        "        \"coverage\": final_metrics[\"coverage\"]\n",
        "    }\n",
        "    best_results.append(result_row)\n",
        "\n",
        "    # -----------------------------\n",
        "    # Plots for this dataset\n",
        "    # -----------------------------\n",
        "\n",
        "    # (a) PCA scatter – true labels\n",
        "    plt.figure(figsize=(6, 5))\n",
        "    scatter = plt.scatter(X_pca[:, 0], X_pca[:, 1], c=y, s=30)\n",
        "    plt.xlabel(\"PC1\")\n",
        "    plt.ylabel(\"PC2\")\n",
        "    plt.title(f\"{name} – PCA colored by true labels\")\n",
        "\n",
        "    unique_y = np.unique(y)\n",
        "    handles = []\n",
        "    for lab in unique_y:\n",
        "        # Decode label for legend\n",
        "        original_label = le.inverse_transform([lab])[0]\n",
        "        handles.append(\n",
        "            plt.Line2D([], [], marker=\"o\", linestyle=\"\",\n",
        "                       label=str(original_label))\n",
        "        )\n",
        "    plt.legend(handles=handles, title=\"True labels\",\n",
        "               bbox_to_anchor=(1.05, 1), loc=\"upper left\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    # (b) PCA scatter – DBSCAN clusters\n",
        "    plt.figure(figsize=(6, 5))\n",
        "    unique_clusters = np.unique(best_cluster_labels)\n",
        "\n",
        "    for c in unique_clusters:\n",
        "        mask = (best_cluster_labels == c)\n",
        "        if c == -1:\n",
        "            plt.scatter(X_pca[mask, 0], X_pca[mask, 1],\n",
        "                        marker=\"x\", s=40, label=\"Noise\")\n",
        "        else:\n",
        "            plt.scatter(X_pca[mask, 0], X_pca[mask, 1],\n",
        "                        s=30, label=f\"Cluster {c}\")\n",
        "\n",
        "    plt.xlabel(\"PC1\")\n",
        "    plt.ylabel(\"PC2\")\n",
        "    plt.title(f\"{name} – PCA colored by DBSCAN clusters\\n\"\n",
        "              f\"(eps={best_eps:.2f}, min_samples={best_ms})\")\n",
        "    plt.legend(bbox_to_anchor=(1.05, 1), loc=\"upper left\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "    # (c) Bar chart of metrics for best configuration\n",
        "    metric_names = [\"purity\", \"accuracy\", \"precision_macro\",\n",
        "                    \"recall_macro\", \"f1_macro\"]\n",
        "    metric_display_names = [\n",
        "        \"Purity\",\n",
        "        \"Accuracy\",\n",
        "        \"Precision (macro)\",\n",
        "        \"Recall (macro)\",\n",
        "        \"F1 (macro)\"\n",
        "    ]\n",
        "    metric_values = [final_metrics[m] for m in metric_names]\n",
        "\n",
        "    plt.figure(figsize=(7, 4))\n",
        "    plt.bar(metric_display_names, metric_values)\n",
        "    plt.ylim(0.0, 1.05)\n",
        "    plt.ylabel(\"Score\")\n",
        "    plt.title(f\"{name} – DBSCAN performance (PCA, best tuned)\")\n",
        "    plt.xticks(rotation=30, ha=\"right\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "# ======================================================\n",
        "# 7. Summary table: best tuning & evaluation per dataset\n",
        "# ======================================================\n",
        "best_results_df = pd.DataFrame(best_results)\n",
        "\n",
